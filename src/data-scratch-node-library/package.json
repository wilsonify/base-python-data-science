{
    "name": "ts-data-scratch",
    "version": "1.0.0",
    "description": "TypeScript Data Science Library - Machine learning algorithms from scratch",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "npx tsc",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "dev": "npx tsc --watch",
        "clean": "rm -rf dist",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "author": "Data Science Team",
    "license": "MIT",
    "devDependencies": {
        "@types/babel__core": "^7.20.5",
        "@types/jest": "^29.5.14",
        "@types/node": "^18.19.130",
        "jest": "^29.5.0",
        "ts-jest": "^29.1.0",
        "typescript": "^4.9.5"
    },
    "overrides": {
        "handlebars": "^4.7.9",
        "@babel/core": "^7.29.6",
        "js-yaml": "^3.15.0",
        "brace-expansion": "^1.1.16"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "keywords": [
        "typescript",
        "data-science",
        "machine-learning",
        "algorithms",
        "statistics",
        "neural-networks",
